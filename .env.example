# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# URLHAUS_API_KEY: Optional. Enables the URLhaus phishing/malware reputation
# lookup (URL + host queries).
# Free Auth-Key at https://auth.abuse.ch/ (set "API only" scope).
# When unset, the reputation card shows "Verification required", the check is
# marked "skipped" (never a pass), and the overall verdict becomes
# VERIFICATION_REQUIRED (never low risk/safe). Setup details are logged
# server-side only — never shown to end users.
URLHAUS_API_KEY=""

# GOOGLE_SAFE_BROWSING_API_KEY: Optional. Enables the Google Safe Browsing
# lookup (phishing / malware / unwanted software) for both the original and the
# post-redirect destination URL. When unset, that source is skipped.
# Get a key at https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=""

# OPENPHISH_FEED_FILE: Optional. Path to a cached OpenPhish/PhishTank feed (one
# URL per line). When the file is absent that source reports "not configured".
OPENPHISH_FEED_FILE="data/openphish.txt"

# TRANCO_LIST_FILE: Optional. Path to a Tranco top-sites list (one domain per
# line, rank = line number). The server downloads the top-1M list here on startup
# and refreshes it daily; a cached file is used if the download fails.
TRANCO_LIST_FILE="data/tranco-top.txt"

# TRANCO_LIST_URL: Optional. Source for the Tranco list download.
TRANCO_LIST_URL="https://tranco-list.eu/top-1m.csv.zip"

# SAFE_BROWSING_API_KEY: alias for GOOGLE_SAFE_BROWSING_API_KEY (either works).
SAFE_BROWSING_API_KEY=""

# GEMINI_MODEL: model for the advisory AI check. Falls back through
# gemini-2.0-flash and gemini-1.5-flash if it is unavailable.
GEMINI_MODEL="gemini-3.8-flash"

# AI_RPM / AI_MAX_CONCURRENCY: cap AI calls (requests per minute, parallel calls).
AI_RPM="10"
AI_MAX_CONCURRENCY="1"

# ---------------------------------------------------------------------------
# Link-protection gateway (backend for safe-link redirection)
# ---------------------------------------------------------------------------
# INSPECTOR_KEY: Bearer token your email/notification script sends in the
# Authorization header when calling POST /api/inspect. If unset, that endpoint
# returns 503 (fail-closed).
INSPECTOR_KEY=""

# OUTLOOK_ADDIN_KEY: Optional. A limited key for the Outlook add-in. When set,
# it is accepted as a Bearer token ONLY on POST /api/inspect,
# GET /api/message/:ref/verdict and POST /api/events (where it also forces
# provider="outlook"). Unset/empty ⇒ add-in access is disabled. It never grants
# admin access. Keep it different from INSPECTOR_KEY.
OUTLOOK_ADDIN_KEY=""

# GMAIL_ADDIN_KEY: Optional. A limited key for the Gmail add-on. Same scope as
# OUTLOOK_ADDIN_KEY, but forces provider="gmail" on POST /api/events. Unset/empty
# ⇒ add-on access is disabled. Keep it different from INSPECTOR_KEY and
# OUTLOOK_ADDIN_KEY. The Gmail add-on runs on Google's servers (Apps Script), so
# it needs a publicly reachable HTTPS GATEWAY_URL — it cannot reach localhost.
GMAIL_ADDIN_KEY=""

# ADMIN_PASSWORD: password for the password-protected /admin review page
# (HTTP Basic auth, any username). If unset, /admin returns 503 (fail-closed).
ADMIN_PASSWORD=""

# VIEWER_PASSWORD: optional read-only login for the /admin area. When set (and
# different from ADMIN_PASSWORD), this password grants view-only access to the
# new Mail Activity UI and the read APIs. If unset, empty, or equal to
# ADMIN_PASSWORD, viewer login stays disabled.
VIEWER_PASSWORD=""

# DB_PATH: where the gateway's SQLite database file lives.
# Defaults to ./data/gateway.db when unset.
DB_PATH="data/gateway.db"

# GATEWAY_URL: public base URL used to build the /go/:id links returned by the
# API (e.g. the URL your recipients will click). Falls back to the request's own
# origin when unset — set this explicitly when running behind a proxy.
GATEWAY_URL=""

# ---------------------------------------------------------------------------
# Mail Activity (mail add-on reporting + /admin/mail)
# ---------------------------------------------------------------------------
# EVENT_SALT: server-side salt used to hash mailbox addresses (SHA-256) before
# they are stored. The raw address is never persisted. Set a long random value.
EVENT_SALT=""

# EVENT_RETENTION_DAYS: how many days of mail activity to keep. A daily job
# deletes rows older than this. Default 30.
EVENT_RETENTION_DAYS="30"

# STORE_SUBJECTS: initial value for the "Store subjects" setting ("1" on, "0"
# off). Can be changed at /admin/mail. When off, only the sender domain is kept.
STORE_SUBJECTS="1"

# ---------------------------------------------------------------------------
# Production deployment (persistent host / Docker)
# ---------------------------------------------------------------------------
# NODE_ENV: set to "production" for the standalone server (enables HTTPS-only
# enforcement below for /api and /admin, and static serving of dist/).
NODE_ENV="production"

# PORT: the TCP port the server listens on. Default 3000.
PORT="3000"

# TRUST_PROXY: how many reverse-proxy hops to trust when reading X-Forwarded-*
# headers so rate limiting sees the real client IP. Accepts `false`, `true`, a
# hop count (usually "1" behind a single TLS-terminating proxy), or a
# comma-separated list of proxy addresses. Defaults to `1` in production.
TRUST_PROXY="1"

# REQUIRE_HTTPS: refuse to serve /api/* and /admin over plain HTTP. Defaults to
# true in production (requires TRUST_PROXY for proxy detection). Set to "false"
# to disable, e.g. for local testing of the production build.
REQUIRE_HTTPS=""
